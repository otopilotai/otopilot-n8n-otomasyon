# Bu dosyayı .env olarak kopyala ve değerleri doldur:  cp .env.example .env
# .env dosyasını ASLA paylaşma veya GitHub'a yükleme.

# n8n'e erişeceğin alan adı (DNS A kaydı sunucu IP'sini göstermeli)
N8N_HOST=n8n.alanadin.com

# Saat dilimi (zamanlanmış workflow'lar bu saate göre çalışır)
GENERIC_TIMEZONE=Europe/Istanbul

# Kimlik bilgilerini şifreleyen anahtar. Üretmek için:  openssl rand -hex 32
# KAYBETME: değişirse kayıtlı kimlik bilgileri açılamaz.
N8N_ENCRYPTION_KEY=degistir_beni
